name: Android Manual CI

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up JDK 11
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '11'
          cache: gradle

      - name: Ensure Gradle wrapper exists (generate & commit if missing)
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -e
          if [ ! -f gradlew ] || [ ! -f gradle/wrapper/gradle-wrapper.properties ]; then
            echo "Gradle wrapper missing — installing Gradle and generating wrapper"
            curl -s "https://get.sdkman.io" | bash
            # shellcheck source=/dev/null
            source "$HOME/.sdkman/bin/sdkman-init.sh"
            sdk install gradle || true
            gradle wrapper
            git config user.name "github-actions[bot]"
            git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
            git add gradlew gradlew.bat gradle/wrapper || true
            git commit -m "ci: add generated Gradle wrapper" || true
            git push origin HEAD || true
          else
            echo "Gradle wrapper present"
          fi

      - name: Grant execute permission for gradlew
        run: chmod +x gradlew || true

      - name: Build with Gradle
        run: ./gradlew build --no-daemon
