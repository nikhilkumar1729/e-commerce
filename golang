package main

import (
	"net/http"

	"github.com/gin-gonic/gin"
	"github.com/stripe/stripe-go/v76"
	"github.com/stripe/stripe-go/v76/paymentintent"
)

// --------------------
// CONFIG
// --------------------
func main() {
	stripe.Key = "sk_test_your_key_here"

	router := gin.Default()

	// --------------------
	// ROUTES
	// --------------------
	router.GET("/products", getProducts)
	router.POST("/cart/add", addToCart)
	router.GET("/cart", viewCart)
	router.POST("/order", createOrder)

	router.Run(":8080")
}

// --------------------
// MODELS
// --------------------
type Product struct {
	ID    int    `json:"id"`
	Name  string `json:"name"`
	Price int64  `json:"price"` // cents
	Stock int    `json:"stock"`
}

type CartItem struct {
	ProductID int `json:"product_id"`
	Quantity  int `json:"quantity"`
}

type Order struct {
	Items []CartItem `json:"items"`
}

// --------------------
// FAKE DATABASE
// --------------------
var products = map[int]Product{
	1: {ID: 1, Name: "Laptop", Price: 100000, Stock: 5},
	2: {ID: 2, Name: "Phone", Price: 50000, Stock: 10},
}

var cart []CartItem

// --------------------
// HANDLERS
// --------------------
func getProducts(c *gin.Context) {
	c.JSON(http.StatusOK, products)
}

func addToCart(c *gin.Context) {
	var item CartItem

	if err := c.ShouldBindJSON(&item); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	cart = append(cart, item)

	c.JSON(http.StatusOK, gin.H{"message": "Item added to cart"})
}

func viewCart(c *gin.Context) {
	c.JSON(http.StatusOK, cart)
}

func createOrder(c *gin.Context) {
	var order Order
	var totalAmount int64 = 0

	if err := c.ShouldBindJSON(&order); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	for _, item := range order.Items {
		product := products[item.ProductID]
		totalAmount += product.Price * int64(item.Quantity)
	}

	params := &stripe.PaymentIntentParams{
		Amount:   stripe.Int64(totalAmount),
		Currency: stripe.String(string(stripe.CurrencyUSD)),
	}

	intent, err := paymentintent.New(params)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"message":               "Order created",
		"total_amount":          totalAmount,
		"payment_client_secret": intent.ClientSecret,
	})
}
